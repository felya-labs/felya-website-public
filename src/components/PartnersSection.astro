---
import { partners } from '../data/site.js';
import type { Locale } from '../i18n/config';
import { t } from '../i18n/translations';

const { locale } = Astro.props as { locale: Locale };

const baseLogoClass = 'partner-logo';
const partnerOrder = [
    'Innovation Hub Bergisches RheinLand',
    'igus',
    'KNIPEX',
    'Würth Elektronik',
    'FIDLOCK',
    'Code & Context',
    'Gateway TH Köln',
    'TH Köln',
    'Solingen Business'
];
const orderedPartners = partnerOrder
    .map((name) => partners.find((partner) => partner.name === name))
    .filter(Boolean);
---

<section class="partner-section section-shell" aria-labelledby="partners-heading">
    <div class="section-inner reveal-block">
        <p class="partner-kicker section-kicker" data-i18n="partners.eyebrow">{t(locale, 'partners.eyebrow')}</p>
        <h2 id="partners-heading" class="partner-heading" data-i18n="partners.heading">{t(locale, 'partners.heading')}</h2>
        <div class="partner-grid">
            {orderedPartners.map((partner) => (
                <span class={`partner-logo-frame ${partner.frameClass}`} data-partner-images data-partner-light-overlay={/--(?:code-and-context|gateway|th-koeln)$/.test(partner.frameClass) || undefined} tabindex="0" role="img" aria-label={partner.name}>
                    <img data-src={partner.darkDefaultSrc} data-partner-variant="dark-default" width={partner.width} height={partner.height} alt="" loading="lazy" decoding="async" class={`${baseLogoClass} partner-logo--dark-default`}>
                    <img data-src={partner.src} data-partner-variant="dark-hover" width={partner.width} height={partner.height} alt="" loading="lazy" decoding="async" class={`${baseLogoClass} partner-logo--dark-hover`}>
                    <img data-src={partner.lightDefaultSrc} data-partner-variant="light-default" width={partner.width} height={partner.height} alt="" loading="lazy" decoding="async" class={`${baseLogoClass} partner-logo--light-default`}>
                    <img data-src={partner.lightHoverSrc} data-partner-variant="light-hover" width={partner.width} height={partner.height} alt="" loading="lazy" decoding="async" class={`${baseLogoClass} partner-logo--light-hover`}>
                    <noscript>
                        {/--(?:code-and-context|gateway|th-koeln)$/.test(partner.frameClass) && (
                            <img src={partner.darkDefaultSrc} width={partner.width} height={partner.height} alt="" loading="lazy" class={`${baseLogoClass} partner-logo--dark-default`}>
                        )}
                        <img src={partner.lightDefaultSrc} width={partner.width} height={partner.height} alt="" loading="lazy" class={`${baseLogoClass} partner-logo--light-default`}>
                    </noscript>
                </span>
            ))}
        </div>
    </div>
</section>
