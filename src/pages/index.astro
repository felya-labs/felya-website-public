---
import BaseLayout from '../layouts/BaseLayout.astro';
import { languageStorageKey, locales } from '../i18n/config';
---

<BaseLayout locale="en" robots="noindex, follow" title="FELYA" description="Choose your language to enter FELYA.">
    <main
        class="locale-entry"
        data-locale-entry
        data-locales={JSON.stringify(locales)}
        data-storage-key={languageStorageKey}
    >
        <a href="/en/">Continue to FELYA</a>
    </main>
    <script type="module" src="/assets/js/locale-redirect.js"></script>
</BaseLayout>
